# ---- secrets: SSH keys and anything like them never enter the repository ----
# DeltaPatcher keeps keys in ~/.ssh and its settings in the user's config folder, never here.
# These lines are the safety net if one is ever copied in by hand.
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*_ed25519
*_ed25519.pub
*_rsa
*_rsa.pub
deltapatcher_*
!deltapatcher/
known_hosts*
authorized_keys*
.ssh/
.env
.env.*
config.json
deltapatcher.ini
signing-key*
*.log
askpass.cmd
askpass.sh

# ---- releases made while testing (stores, installs, partial downloads) ----
store/
stores/
.deltapatcher/
.deltapatcher-hashcache.json
*.part
*.dp-new
test-data/

# ---- builds ----
build/
dist/
*.spec.bak
tools/icon-preview.png

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- editors and OS ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
